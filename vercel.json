{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "./",
      "entrypoint": "api.main:app",
      "functions": {
        "api/main.py": {
          "maxDuration": 120,
          "excludeFiles": "{web/**,tests/**,.venv/**,tiles/build/**,design_handoff_parcel_feasibility_map/**,data/loaders/**,**/*.pmtiles,**/*.mbtiles,**/*.zip,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "api" } }
  ]
}
