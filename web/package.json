{
  "name": "residual-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:popup": "esbuild --bundle scripts/check-popup-placement.mjs --format=esm --platform=node --outfile=node_modules/.cache/popup-check.mjs --log-level=error && node node_modules/.cache/popup-check.mjs",
    "check:map": "esbuild --bundle scripts/check-map-style.mjs --format=esm --platform=node --outfile=node_modules/.cache/map-check.mjs --log-level=error && node node_modules/.cache/map-check.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "pmtiles": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
